{
  "name": "jev-focus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "VITE_JEV_MOCK=1 vite build --watch",
    "dev:content": "VITE_JEV_MOCK=1 vite build --config vite.content.config.ts --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build && vite build --config vite.bar.config.ts && vite build --config vite.content.config.ts && node scripts/verify-build.mjs",
    "build:mock": "VITE_JEV_MOCK=1 pnpm build",
    "test": "vitest run",
    "test:e2e": "pnpm build:mock && node tests/e2e/run.mjs",
    "dev:bar": "VITE_JEV_MOCK=1 vite build --config vite.bar.config.ts --watch"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.11",
    "happy-dom": "20.8.9",
    "@testing-library/react": "16.3.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/user-event": "14.6.1",
    "playwright": "1.59.1"
  },
  "pnpm": {
    "overrides": {
      "tinyexec": "1.3.0",
      "ws": ">=8.21.3"
    }
  }
}
